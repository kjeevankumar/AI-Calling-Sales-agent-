# ==============================================================================
# AI Calling Sales Agent — Environment Configuration Template
# ==============================================================================

# ─── STEP 1: Gemini Live API (Google AI Studio) ──────────────────────────────
# Obtain your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ─── STEP 2: Telephony Configuration ─────────────────────────────────────────
# --- OPTION A: Twilio (Global / US / International) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# --- OPTION B: Exotel (India / TRAI 140-Series Compliant) ---
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
CALLER_ID=+911400000000

# ─── STEP 3: Public Webhook / WebSocket Tunnel URL ───────────────────────────
# Use ngrok, Pinggy, or Localtunnel to expose port 8000 during local dev
SERVER_URL=https://your-public-domain-or-tunnel.com

# ─── STEP 4: Database Connection ─────────────────────────────────────────────
# Default: Local SQLite database
DATABASE_URL=sqlite:///./calls.db

# Production: High-concurrency PostgreSQL connection
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_sales_calling_db
